{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "bunx @better-auth/cli generate --output src/db/schema.ts",
    "db:migrate": "bunx drizzle-kit migrate",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@notionhq/client": "^5.22.0",
    "better-auth": "latest",
    "drizzle-orm": "latest",
    "hono": "latest",
    "postgres": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "latest",
    "@types/bun": "latest",
    "typescript": "latest",
    "eslint": "latest",
    "@antfu/eslint-config": "latest"
  }
}
